{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MedicationCatalog": {
    "RxNorm": {
      "BaseAddress": "https://rxnav.nlm.nih.gov/REST/",
      "CacheTtlHours": 12,
      "RetryAttempts": 2,
      "AttemptTimeoutSeconds": 3,
      "TotalRequestTimeoutSeconds": 10
    }
  },
  "RateLimiting": {
    "GeneralPermitLimit": 120,
    "GeneralWindowSeconds": 60,
    "BurstPermitLimit": 20,
    "BurstWindowSeconds": 10,
    "ConcurrentPermitLimit": 8,
    "MutationPermitLimit": 30,
    "MutationWindowSeconds": 60,
    "MedicationSearchPermitLimit": 20,
    "MedicationSearchWindowSeconds": 60,
    "ReadinessPermitLimit": 30,
    "ReadinessWindowSeconds": 60
  },
  "Release": {
    "Revision": "local"
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "AllowedHosts": "*"
}
